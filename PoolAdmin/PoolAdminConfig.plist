<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Optional: leave empty to use offline runtime grants only (default, safest). -->
	<!-- <key>GrantEndpoint</key><string>https://example.com/api/grants</string> -->
	<key>Catalog</key>
	<array/>
	<key>Presets</key>
	<array/>
	<!-- Subsystem kill-switches. All default to YES when missing.
	     Set one to <false/> and repack the IPA to isolate a crash
	     without rebuilding the dylib. -->
	<key>PAEnableIntegrityBypass</key><true/>
	<key>PAEnableStoreHooks</key><true/>
	<key>PAEnableOverlay</key><true/>
	<key>PAEnablePanel</key><true/>
</dict>
</plist>
